---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign pages = site.html_pages | sort: 'url' %}
  {% for entry in pages %}
    {% unless entry.sitemap == false or entry.layout == 'redirect' %}
  <url>
    <loc>{{ entry.url | absolute_url | xml_escape }}</loc>
  </url>
    {% endunless %}
  {% endfor %}
</urlset>
